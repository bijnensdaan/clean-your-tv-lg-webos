{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "builtin:apple",
  "title": "Apple",
  "description": "Calm tvOS-inspired layered glass over an original soft backdrop, on the Classic dock with the Inputs shelf.",
  "author": {
    "name": "Clean Your TV contributors",
    "url": "https://github.com/razdva122"
  },
  "themeVersion": "1.0.0",
  "layout": {
    "preset": "dock-grid",
    "columns": 5,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1,
    "allowColumnOverride": true,
    "motion": "classic",
    "inputs": "shelf",
    "weather": {
      "formats": [
        "text"
      ],
      "scale": 1,
      "padding": 0,
      "icons": "fill"
    }
  },
  "defaults": {
    "wallpaperAssetId": "wallpaper",
    "dim": 0,
    "accent": "#f5f7fb"
  },
  "assets": [
    {
      "id": "wallpaper",
      "path": "assets/backdrop.jpg",
      "mediaType": "image/jpeg",
      "width": 1920,
      "height": 1080
    },
    {
      "id": "preview",
      "path": "assets/preview.jpg",
      "mediaType": "image/jpeg",
      "width": 960,
      "height": 540
    }
  ],
  "previewAssetId": "preview",
  "license": {
    "identifier": "MIT",
    "textPath": "LICENSE.txt",
    "creditsPath": "CREDITS.txt"
  }
}
